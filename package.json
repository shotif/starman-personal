{
  "name": "starman-lightkeeper",
  "private": true,
  "version": "0.0.1",
  "description": "A 3D third-person story RPG among the real nearby stars, in the universe of Starman Reborn and Starman Control.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "key:meshy": "bash scripts/set-meshy-key.sh",
    "art:materials": "node scripts/art/materials.ts",
    "art:trellis": "node scripts/art/trellis.ts",
    "art:concepts": "node scripts/art/concepts.ts",
    "art:meshy": "node scripts/art/meshy.ts",
    "art:props": "node scripts/art/props.ts",
    "art:models": "node scripts/art/models.ts",
    "art:models-low": "node scripts/art/models-low.ts",
    "art:images": "node scripts/art/images.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@babylonjs/addons": "9.32.0",
    "@babylonjs/core": "9.32.0",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.32.0",
    "@preact/signals": "2.11.3",
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/generators": "0.43.1",
    "inkjs": "2.4.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
