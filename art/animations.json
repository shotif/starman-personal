{
  "about": "The animation set every character .glb carries. Clips come from Quaternius's Universal Animation Library (UAL, CC0): Library 1 Pro (bought by the owner) and Library 2 Standard. 'upright' clips are rebuilt as an upright stance on the source skeleton before retargeting (common.make_upright); 'straighten' takes that share of the spine's average forward bend out of a clip (common.straighten). 'derived' clips are made from another clip on each character (common.derive_clip): played backwards, slowed, or softened towards the idle. Read by scripts/art/mannequin.py and scripts/art/hero.py.",
  "fps": 30,
  "libraries": {
    "ual1": {
      "file": "art/cache/ual1-pro-source/Unreal-Godot/UAL1.glb",
      "naming": "unreal",
      "note": "UAL 1 Pro, in-place version (no root motion)"
    },
    "ual2": {
      "file": "art/cache/ual2/Universal Animation Library 2 [Standard]/Unreal-Godot/UAL2_Standard.glb",
      "naming": "unreal"
    }
  },
  "clips": [
    {
      "name": "idle",
      "library": "ual1",
      "source": "Idle_Loop",
      "loop": true,
      "upright": {
        "lean_back_deg": 3.0,
        "sway": 0.5
      },
      "note": "UAL's idle made upright: feet under the hips, knees nearly straight, chest up"
    },
    {
      "name": "idle_talk",
